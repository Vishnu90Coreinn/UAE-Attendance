<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HrPayroll.Api</RootNamespace>
    <AssemblyName>HrPayroll.Api</AssemblyName>
    <!-- Holds the development-only Seed:AdminUsername and Seed:AdminPassword (see README, First run) -->
    <UserSecretsId>hrpayroll-api-3f6b1c8e-5a47-4d2e-9b0a-7c1d2e4f8a90</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Direct pin: Microsoft.Data.SqlClient pulls a vulnerable 9.0.11 transitively (NU1902/NU1903). Remove once SqlClient raises its own floor. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Pdf/Fonts/*.ttf" />
    <EmbeddedResource Include="Pdf/Assets/*.jpg" />
    <None Update="Pdf/Fonts/LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Pdf/Licenses/PdfPig-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
