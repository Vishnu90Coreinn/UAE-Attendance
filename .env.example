# NOTE: .NET does not load this file. It only documents the variables; set them in the real environment.

# Connection to the HR database. Use a dedicated SQL login with rights on this database only.
ConnectionStrings__Default=Server=<host>;Database=HrPayroll;User Id=<hr_app_login>;Password=<password>;Encrypt=True;TrustServerCertificate=False

# Logging (optional)
Observability__WriteToFile=true
Observability__LogDirectory=logs

# Apply EF migrations automatically at start-up. Leave unset in production; apply migrations with `dotnet ef` instead.
Database__MigrateOnStartup=false

# Token signing. Jwt__Key is required: 32+ random characters, kept secret. The API refuses to start without it.
Jwt__Key=<random string of 32 or more characters>
Jwt__Issuer=HrPayroll
Jwt__Audience=HrPayrollWeb
# Sign-in lifetime in hours (default 8)
Jwt__ExpiryHours=8

# First administrator. Needed only for the very first start (empty Users table); remove both afterwards.
# The password must be 10-128 characters and different from the username.
Seed__AdminUsername=<first administrator username>
Seed__AdminPassword=<first administrator password>

# Maximum sign-in attempts per client IP per minute (default 10)
RateLimiting__LoginPerMinute=10
